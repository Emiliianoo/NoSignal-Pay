# Copy this file to .env (cp .env.example .env) and fill in the values.
# .env is ignored by git. Never commit real secrets.

# PostgreSQL container credentials (used by the "postgres" service in docker-compose.yml).
POSTGRES_USER=nosignal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nosignal_pay

# SQLAlchemy connection URL used by the API. The host is "postgres" (the compose service name),
# not localhost, because the API runs inside its own container.
DATABASE_URL=postgresql+psycopg://nosignal:change-me@postgres:5432/nosignal_pay

# Secret used to sign JWTs (HS256).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
